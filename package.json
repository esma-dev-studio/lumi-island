{
  "name": "lumi-island",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5183 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5184",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "eslint src tools tests",
    "format": "prettier -w \"src/**/*.{ts,css}\" \"tools/**/*.mjs\" \"*.md\"",
    "gen:characters": "node tools/chargen/generate.mjs",
    "check:chars": "node tools/charcheck.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run check:chars"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@babylonjs/loaders": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@gltf-transform/core": "^4.1.0",
    "@playwright/test": "^1.49.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "puppeteer-core": "^23.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
